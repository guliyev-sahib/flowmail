# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowmail?schema=public"

# --- Redis (background jobs) ---
REDIS_URL="redis://localhost:6379"

# --- Shopify app credentials ---
# Create a dev app at https://partners.shopify.com
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_SCOPES="read_customers,read_orders,read_products,write_checkouts"
SHOPIFY_APP_URL="http://localhost:3000"

# --- Email delivery (start with SMTP) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="hello@yourstore.com"

# --- App ---
APP_SECRET="change-me-to-a-long-random-string"
